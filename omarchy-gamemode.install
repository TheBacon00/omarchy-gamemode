post_install() {
    echo "=========================================================================="
    echo "Omarchy Game Mode installed successfully."
    echo ""
    echo "1. Configure your display settings (Resolution/Refresh Rate) in:"
    echo "   /etc/omarchy-gamemode.conf or ~/.config/omarchy-gamemode.conf"
    echo ""
    echo "2. Add a keybinding to your window manager to enter Game Mode:"
    echo "   steamos-session-select gamescope"
    echo ""
    echo "3. Moonlight HDR Settings:"
    echo "   If launching Moonlight via Steam, set the Launch Options to:"
    echo "   QT_QPA_PLATFORM=xcb SDL_VIDEO_DRIVER=x11 SDL_VIDEODRIVER=x11 PREFER_VULKAN=1 ENABLE_HDR_WSI=1 vblank_mode=0 __GL_SYNC_TO_VBLANK=0 %command%"
    echo "=========================================================================="
}

post_upgrade() {
    post_install
}
